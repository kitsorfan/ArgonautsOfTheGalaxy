{
  "name": "astrotroubles",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~58.0.28",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.31",
    "expo-screen-orientation": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-store-review": "~58.0.3",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/m-plus-rounded-1c": "^0.4.4",
    "@expo-google-fonts/orbitron": "^0.4.2",
    "@expo-google-fonts/play": "^0.4.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/three": "^0.187.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "subset-font": "^2.9.0",
    "three": "^0.187.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "npm run game:build && expo start",
    "android": "npm run game:build && expo start --android",
    "ios": "npm run game:build && expo start --ios",
    "web": "npm run game:build && expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "typecheck": "npm run game:build && tsc --noEmit",
    "gen:icons": "node game/tools/run.mjs icons",
    "game:build": "node game/build.mjs",
    "game:dev": "node game/build.mjs --watch",
    "game:check": "node game/tools/run.mjs levelcheck",
    "game:i18n": "node game/tools/run.mjs i18n",
    "trailer": "node game/tools/trailer.mjs",
    "voice": "node game/tools/run.mjs voice",
    "eas-build-post-install": "npm run game:build"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testRegex": "game.tests.*[.]test[.]tsx?$",
    "testPathIgnorePatterns": ["/node_modules/", "<rootDir>/.claude/"],
    "modulePathIgnorePatterns": ["<rootDir>/.claude/"],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|three/))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  }
}

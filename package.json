{
  "name": "astrotroubles",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.20",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-screen-orientation": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/m-plus-rounded-1c": "^0.4.4",
    "@expo-google-fonts/orbitron": "^0.4.2",
    "@expo-google-fonts/play": "^0.4.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "subset-font": "^2.9.0",
    "three": "^0.186.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "npm run game:build && expo start",
    "android": "npm run game:build && expo start --android",
    "ios": "npm run game:build && expo start --ios",
    "web": "npm run game:build && expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "typecheck": "npm run game:build && tsc --noEmit",
    "gen:icons": "node game/tools/gen-icons.mjs",
    "game:build": "node game/build.mjs",
    "game:dev": "node game/build.mjs --watch",
    "game:check": "node game/tools/run.mjs levelcheck",
    "game:i18n": "node game/tools/run.mjs i18n",
    "eas-build-post-install": "npm run game:build"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testRegex": "game.tests.*[.]test[.]tsx?$",
    "testPathIgnorePatterns": ["/node_modules/", "<rootDir>/.claude/"],
    "modulePathIgnorePatterns": ["<rootDir>/.claude/"]
  }
}
